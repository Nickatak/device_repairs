# device_repair_website environment template.
# Copy to .env.local and adjust. `make env-init` activates it as .env.

APP_ENV=local

# Host-published ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# Backend (Django)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. DATABASE_URL host is 127.0.0.1 for host-process runs; the backend
# container overrides it to db:5432 via docker-compose.yml.
DATABASE_URL=postgres://repair:repair_password@127.0.0.1:5432/device_repair
POSTGRES_DB=device_repair
POSTGRES_USER=repair
POSTGRES_PASSWORD=repair_password
